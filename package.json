{
  "name": "dsh-team-roles",
  "version": "0.5.0",
  "description": "Durable role profiles, native Team integration and native Web settings for DSH",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "exports": {
    ".": "./src/host.mjs",
    "./host": "./src/host.mjs",
    "./roles": "./src/roles/index.mjs",
    "./auth": "./src/auth/provider.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./remote": "./src/teams/remote.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:native && npm run test:runtime && node --test test/release/*.test.mjs",
    "test:unit": "node --test test/auth/*.test.mjs test/teams/*.test.mjs test/roles/*.test.mjs test/native/synthetic-fixtures.test.mjs",
    "test:native": "node --test test/native/*.test.mjs",
    "test:runtime": "node --test test/runtime/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "pack:check": "npm pack --dry-run",
    "runtime:verify": "node scripts/runtime/verify.mjs",
    "prepack": "node scripts/check-package.mjs",
    "build:release": "npm run build",
    "test:release": "npm test"
  },
  "files": [
    "src",
    "lib",
    "docs/runtime.md",
    "docs/configuration.md",
    "docs/protocol.md",
    "docs/auth.md",
    "scripts/check-package.mjs",
    "scripts/runtime/verify.mjs",
    "scripts/live/host-fixture.mjs",
    "test/fixtures/audit.mjs",
    "test/fixtures/synthetic-files.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs/validation.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.8-alpha.1",
